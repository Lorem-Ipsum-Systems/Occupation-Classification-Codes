{
    "name": "lorem-ipsum-systems/occupation-classification-codes",
    "description": "Occupational and employee classification codes (SOC, UK SOC, ISCO)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ClassificationOccupation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClassificationOccupation\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Lorem Ipsum Systems"
        }
    ],
    "keywords": [
        "occupation",
        "classification",
        "soc",
        "uk-soc",
        "isco",
        "standard-occupational-classification"
    ],
    "support": {
        "issues": "https://github.com/lorem-ipsum-systems/occupation-classification-codes/issues",
        "source": "https://github.com/lorem-ipsum-systems/occupation-classification-codes"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "composer-validate": "composer validate --strict",
        "validate-data": "vendor/bin/phpunit tests/DataIntegrityTest.php",
        "quality": [
            "@composer-validate",
            "@test",
            "@validate-data"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}